# Authentoire Configuration Settings

[security]
# PIN session timeout in seconds (default: 300 = 5 minutes)
pin_timeout_seconds = 300

[encryption]
enable_encryption = true
encryption_key = "base64-encoded-32-bytes"


[web]
# Route prefix for the application
route_prefix = "/authentoire"
base_url = "https://smartoire.com"

[debug]
# Enable debug logging on backend
# Set to true for development/debugging, false for production
debug_enabled = true

# Enable debug logging on JavaScript frontend
# Set to true for development/debugging, false for production
js_debug_enabled = true

[ui]
# Show detailed error messages to users
# Set to true for development, false for production (shows generic messages)
verbose_errors = true

[performance]
# Enable performance monitoring
# Set to true to track response times and performance metrics
performance_monitoring = true
